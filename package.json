{
  "name": "lost-legacies-live",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
