# ==============================================================================
# Lost Legacies Live — Root Environment Template
# Copy to .env for local development. NEVER commit real secrets.
# Values below are placeholders; generate unique local keys and tokens.
# ==============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- JUSCR Spine & Time Engine (archonfractureback) ---
SPINE_API_URL=http://localhost:4000
SPINE_INTERNAL_SERVICE_TOKEN=replace_with_local_dev_token

# --- PostgreSQL (Disposable / Local Dev) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lost_legacies_dev

# --- Secret Rooms & Encryption Boundaries ---
# Generate a unique 32-byte key locally: openssl rand -hex 32
# Do not use an all-zero key outside disposable examples.
SECRET_ROOM_MASTER_KEY=replace_with_64_hex_char_local_key

# --- Auth & Identity (Reserved for Phase 2) ---
AUTH_SECRET=replace_with_local_auth_secret
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000
